<template name="proofs">
 <view class="proof" wx:for="{{rows}}" wx:key="evidence_id"><view class="rowtitle">{{item.evidence_type}} · {{item.sourceText}} · {{item.statusText}}</view><text selectable class="id">{{item.evidence_id}}</text><view>点位 {{item.checkpoint_id || '未关联'}} · 来源 {{item.source_id}}</view><view>观察时间 {{item.observed_at || '未提供'}}</view><view>取得时间 {{item.retrieved_at || '未提供'}} · 有效至 {{item.valid_until || '未提供'}}</view><view wx:if="{{item.error}}" class="error">{{item.error}}</view><text selectable class="evidence">{{item.valueText}}</text><text selectable class="id">取证链：{{item.provenanceText}}</text></view>
</template>
<view class="page">
 <view class="eyebrow">INSPECTGO / 现场复核</view><view class="title">现场证据，逐项核对</view>
 <view class="notice" wx:if="{{!configured}}">工程接入 · AppID 未配置。仅用于本地开发者工具；尚未通过微信平台或真机验证。</view>
 <view class="muted">接口：{{base}} · 人员为手工记录，不构成身份认证。</view><view class="error" wx:if="{{error}}" selectable>{{error}}</view><view class="notice" wx:if="{{message}}" selectable>{{message}}</view>
 <view class="section"><view class="heading">实际设施点位</view><picker range="{{facilities}}" range-key="label" value="{{pointIndex}}" bindchange="selectPoint"><view class="picker">{{selectedPoint || '选择后端实际点位'}} ▾</view></picker><view wx:if="{{point}}"><view>{{point.point_id}} · {{point.name}} · {{point.zone_name}}</view><view class="muted">最近现场时间 {{point.last_inspection_at || '暂无现场记录'}} · 照片 {{point.photo_count}} 张</view><view class="proof" wx:for="{{pointRecords}}" wx:key="id"><view>{{item.inspector_id || '历史记录未提供人员'}} · {{item.resultText}} · {{item.source}}</view><view>{{item.inspected_at || item.created_at}}</view><text selectable>{{item.evidence}}</text></view></view></view>
 <view class="section"><view class="heading">待复核请求</view><button bindtap="refresh" size="mini">刷新实时清单</button><view class="muted" wx:if="{{!items.length}}">当前清单无待处理项；网络错误见上方提示。</view><button class="request" wx:for="{{items}}" wx:key="review_id" data-id="{{item.review_id}}" bindtap="openReview" disabled="{{busy}}">{{item.point_id}} · {{item.statusText}} · {{item.reason}}</button></view>
 <view class="section" wx:if="{{review}}"><view class="heading">请求上下文 · {{statusText}}</view><text class="id" selectable>{{review.review_id}}</text><view>点位 {{review.point_id}} · 设施 {{review.facility_id}} · 区域 {{review.zone_id}}</view><view>任务 {{review.task_id || '未关联'}} · 轮次 {{review.inspection_round_id || '未关联'}} · 版本 {{review.version}}</view><view>原因：{{review.reason}}</view><view>创建 {{review.created_at}} · 到期 {{review.expires_at || '未提供'}}</view><view wx:if="{{review.close_reason}}">结束原因：{{review.close_reason}}</view><button size="mini" data-id="{{review.trigger_run_id}}" bindtap="chooseRun" wx:if="{{review.trigger_run_id}}">查看触发运行</button><view class="heading">实时证据历史</view><view class="muted" wx:if="{{!reviewProofs.length}}">暂无关联证据</view><template is="proofs" data="{{rows: reviewProofs}}"/><view class="heading">已保存现场照片</view><view class="photo" wx:for="{{savedPhotos}}" wx:key="image_id"><image src="{{item.absoluteUrl}}" mode="aspectFill" data-url="{{item.absoluteUrl}}" bindtap="previewSaved"/></view><view class="heading">后续 reality 运行</view><view class="proof" wx:for="{{newRuns}}" wx:key="version"><view>复核版本 {{item.version}} · {{item.run_id ? '已生成' : '待判断'}}</view><text class="id" selectable>{{item.run_id || item.error || '尚未生成运行；证据已保存'}}</text><button size="mini" wx:if="{{item.run_id}}" data-id="{{item.run_id}}" bindtap="chooseRun">读取本次判断</button></view></view>
 <view class="section"><view class="heading">已保存运行 · 冻结证据</view><input placeholder="run_id（也可由请求自动选择）" value="{{runId}}" bindinput="runInput"/><button bindtap="loadRun" size="mini">从后端读取运行</button><view class="muted">任务、覆盖、方案和证据均读取服务端快照，客户端不重新判断。</view>
 <view wx:if="{{run}}"><text class="id" selectable>{{run.run_id}}</text><view>轮次 {{run.inspection_round_id}} · {{run.run_type}} · {{run.rule_version}}</view><view>判断时点 {{run.as_of}}</view><view class="heading">必检覆盖 {{run.coverage.covered}} / {{run.coverage.required}}</view><view>缺口点位：{{run.missingText || '无'}}</view><view class="muted">窗口 {{run.coverage.window_start}} 至 {{run.coverage.window_end}}。现场覆盖与设施正常分开判断。</view>
 <view class="heading">五项任务</view><view class="proof" wx:for="{{run.tasks}}" wx:key="task_id"><view class="rowtitle">{{item.task_id}} · {{item.name}} · {{item.stateText}}</view><view>{{item.reason}}</view><view class="check" wx:for="{{item.checks}}" wx:for-item="check" wx:key="dependency_id"><view>{{check.dependency_id}} · {{check.statusText}} · {{check.reason}}</view><text class="id" selectable>依据 {{check.refs || '无证据引用'}}</text></view></view>
 <view class="heading">候选方案</view><view wx:if="{{!run.plans.length}}" class="muted">此运行未提供候选方案结果。</view><view class="proof" wx:for="{{run.plans}}" wx:key="plan_id"><view class="rowtitle">{{item.name || item.plan_id}} · {{item.stateText}}</view><view>案例估计 {{item.estimated_minutes}} 分钟 · {{item.reason}}</view><view class="check" wx:for="{{item.checks}}" wx:for-item="check" wx:key="dependency_id"><view>{{check.statusText}} · {{check.reason}}</view><text class="id" selectable>依据 {{check.refs || '无证据引用'}}</text></view></view>
 <view class="heading">运行取证链</view><template is="proofs" data="{{rows: run.proofs}}"/><button size="mini" bindtap="toggleDebug">{{debug ? '收起原始 JSON' : '展开原始 JSON（辅助核对）'}}</button><text wx:if="{{debug}}" class="evidence" selectable>{{runText}}</text></view></view>
  <view class="section" wx:if="{{draft &amp;&amp; review}}"><view class="heading">现场补证草稿</view><view class="notice" wx:if="{{locked}}">原请求已锁定。网络结果不确定时只允许原样重试；409 冲突需显式核对最新版本。草稿不会自动提交。</view>
    <label>现场人员<input data-field="inspector_id" value="{{draft.fields.inspector_id}}" maxlength="80" disabled="{{locked || busy}}" bindinput="field" placeholder="填写实际巡检人"/></label>
    <label>实际现场时间（带时区 ISO）<input data-field="inspected_at" value="{{draft.fields.inspected_at}}" disabled="{{locked || busy}}" bindinput="field" placeholder="例如 2026-11-01T18:00:00+08:00"/></label><button size="mini" bindtap="now" disabled="{{locked || busy}}">填写当前时间</button>
    <picker range="{{resultOptions}}" value="{{resultIndex}}" bindchange="result" disabled="{{locked || busy}}"><view class="picker">现场结果：{{resultOptions[resultIndex]}}</view></picker>
    <picker range="{{conclusionOptions}}" value="{{conclusionIndex}}" bindchange="conclusion" disabled="{{locked || busy}}"><view class="picker">人工结论：{{conclusionOptions[conclusionIndex]}}</view></picker>
    <label>现场说明<textarea data-field="notes" value="{{draft.fields.notes}}" maxlength="2000" disabled="{{locked || busy}}" bindinput="field" placeholder="记录实际观察；无法确认请说明原因"/></label>
    <checkbox-group bindchange="onsite"><label><checkbox value="onsite" checked="{{draft.fields.onsite_confirmed === 'true'}}" disabled="{{locked || busy}}"/>我确认已到现场核验</label></checkbox-group>
    <view class="muted">照片最多 5 张，每张 10 MB。仅草稿存入本机；如照片丢失将明确报错。</view><button bindtap="photos" disabled="{{locked || busy || draft.photos.length >= 5}}">拍照 / 从相册选取</button>
    <view class="photo" wx:for="{{draft.photos}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="preview"/><button size="mini" data-index="{{index}}" bindtap="removePhoto" disabled="{{locked || busy}}">移除</button></view>
    <view class="muted" wx:if="{{!voiceEnabled}}">语音未配置；可直接输入文字。</view><view wx:if="{{voiceEnabled}}"><button bindtap="startVoice" disabled="{{locked || busy || recording}}">开始语音记录</button><button bindtap="stopVoice">停止录音</button><text selectable>{{voiceText}}</text><button bindtap="acceptVoice" disabled="{{locked || busy || !voiceText}}">确认将识别文字加入草稿</button><button bindtap="speak">朗读现场说明</button><text class="error">{{voiceError}}</text></view>
    <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || review.status !== 'pending' &amp;&amp; !locked}}">{{locked ? '使用原请求核对 / 重试' : '提交现场证据与人工结论'}}</button><button wx:if="{{conflict}}" bindtap="reconcile" disabled="{{busy}}">409 冲突：核对最新版本并保留草稿</button>
  </view>
</view>
