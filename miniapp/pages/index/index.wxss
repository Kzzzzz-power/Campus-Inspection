page{background:#f3f5f4;color:#17343a;font-size:28rpx}.page{padding:36rpx 28rpx 90rpx}.eyebrow{letter-spacing:4rpx;font-size:22rpx;color:#607b80}.title{font-size:44rpx;font-weight:600;margin:20rpx 0 30rpx}.section{background:white;padding:28rpx;margin:24rpx 0;border-radius:12rpx;border:1rpx solid #dce4e2}.heading{font-size:32rpx;font-weight:600;margin:12rpx 0 24rpx}.notice,.error{padding:22rpx;margin:20rpx 0;line-height:1.6;background:#fff3cf;color:#665017}.error{background:#ffe9e4;color:#952e24}.muted{color:#637679;font-size:24rpx;line-height:1.7;margin:16rpx 0}.picker,input,textarea{border:1rpx solid #bfd0ce;padding:20rpx;box-sizing:border-box;margin:16rpx 0;min-height:84rpx;width:100%;border-radius:6rpx}textarea{height:240rpx}.evidence{display:block;font-family:monospace;font-size:24rpx;white-space:pre-wrap;word-break:break-all;line-height:1.6;margin:18rpx 0;padding:16rpx;background:#f3f6f5}.request{text-align:left;font-size:26rpx;margin:18rpx 0}.primary{background:#123a42;color:white;margin-top:32rpx}button{margin:14rpx 0;font-size:28rpx}.photo{display:inline-block;margin:12rpx}.photo image{height:150rpx;width:150rpx}label{display:block;margin:24rpx 0}

.proof{padding:22rpx 0;border-top:1rpx solid #dce4e2;line-height:1.7}.rowtitle{font-weight:600}.id{display:block;font-size:22rpx;color:#5c7377;word-break:break-all}.check{border-left:4rpx solid #a8bfbc;padding-left:16rpx;margin:16rpx 0}
