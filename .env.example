# Launcher process environment (set in PowerShell; this file does not set launcher paths automatically):
# INSPECTGO_PYTHON=<absolute existing project/shared Python 3.11 executable>
# INSPECTGO_BROKER_PYTHON=<absolute existing broker Python executable>
# These server settings are never copied to miniapp/config.js.
# Start-Realtime.ps1 sets these for its local child processes.
# Uvicorn can also load this copied file explicitly with --env-file.
INSPECTGO_MQTT_ENABLED=true
INSPECTGO_MQTT_HOST=127.0.0.1
INSPECTGO_MQTT_PORT=1883
INSPECTGO_STALE_SECONDS=10
INSPECTGO_SEED_DEMO=false
# Server-only optional explanation. Empty credentials produce an honest degraded run.
INSPECTGO_LLM_ENABLED=false
INSPECTGO_LLM_BASE_URL=
INSPECTGO_LLM_MODEL=
INSPECTGO_LLM_API_KEY=
# Optional absolute path to an existing private local env file; never commit its contents.
INSPECTGO_LLM_ENV_FILE=
# Opt in if this server requires the system/environment HTTP proxy.
INSPECTGO_HTTP_TRUST_ENV=false
# Independent photo transmission opt-in; no credential reuse unless explicitly enabled.
INSPECTGO_VLM_ENABLED=false
# Only enable for an image-capable model. Reuses the whole LLM profile when all VLM fields below are empty.
# Partial VLM overrides never inherit the shared key. Each photo still requires the user's consent.
INSPECTGO_VLM_REUSE_LLM=false
INSPECTGO_VLM_BASE_URL=
INSPECTGO_VLM_MODEL=
INSPECTGO_VLM_API_KEY=

# Optional local ASR. Setup-Speech.ps1 installs the pinned model under .runtime/models.
# Empty uses the project-local model. On Linux/cloud, set an absolute mounted model directory.
INSPECTGO_ASR_MODEL_PATH=
